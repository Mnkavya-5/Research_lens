# Copy to .env and fill in. .env is gitignored; never commit it.

# Contact email sent to arXiv/Crossref so they can reach you (polite API use)
CONTACT_EMAIL=you@example.com

# Optional: Tavily web search (free tier: 1,000 searches/month, sign up at tavily.com).
# Without it, web search uses Wikipedia + Hacker News.
# TAVILY_API_KEY=tvly-...

# Optional: Ollama model for answers (default qwen3:1.7b; qwen3:4b needs more RAM)
# OLLAMA_MODEL=qwen3:1.7b

# Optional: separate model for the experimental LLM judge
# JUDGE_MODEL=qwen3:4b
